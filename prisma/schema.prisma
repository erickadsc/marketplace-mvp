generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserType {
  CLIENT
  BROKER
}

enum ProposalStatus {
  ACTIVE
  EXPIRED
  INVALID
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  password       String
  type           UserType
  score          Float           @default(5.0)
  createdAt      DateTime        @default(now())
  searchProfiles SearchProfile[]
  brokerOffers   Proposal[]      @relation("ProposalBroker")
  clientReviews  Review[]        @relation("ReviewClient")
  brokerReviews  Review[]        @relation("ReviewBroker")
}

model SearchProfile {
  id           Int        @id @default(autoincrement())
  userId       Int
  listingType  String     @default("locacao")
  city         String
  district     String
  minPrice     Decimal    @db.Decimal(12, 2)
  maxPrice     Decimal    @db.Decimal(12, 2)
  bedrooms     Int
  bathrooms    Int
  parkingSpots Int
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposals    Proposal[]
}

model Proposal {
  id                   Int            @id @default(autoincrement())
  brokerId             Int
  profileId            Int
  propertyLink         String
  price                Decimal        @db.Decimal(12, 2)
  note                 String
  availabilityConfirmed Boolean
  status               ProposalStatus @default(ACTIVE)
  createdAt            DateTime       @default(now())
  expiresAt            DateTime
  broker               User           @relation("ProposalBroker", fields: [brokerId], references: [id], onDelete: Cascade)
  profile              SearchProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  review               Review?
}

model Review {
  id         Int      @id @default(autoincrement())
  proposalId Int      @unique
  clientId   Int
  brokerId   Int
  rating     Int
  comment    String
  createdAt  DateTime @default(now())
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  client     User     @relation("ReviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  broker     User     @relation("ReviewBroker", fields: [brokerId], references: [id], onDelete: Cascade)
}
